# Ignore heavy AI models
# 1. Track the parent directory itself
!models/

# 2. Ignore everything deep inside the parent directory
models/**

# 3. Explicitly un-ignore the specific files you want to keep
!models/models.json
!models/installed-models.txt
!models/GGUF model list.htm

# 4. Optional: Keep all files of a certain type across any subdirectory
ollama/
vendor/
hf_cache/
agent_workspace/
AIcodes/
AnythingLLM/
anythingllm_data/
ggufloader/
godmod3/
llama.cpp/
LM Studio/


# 5. Ignore private chat history and local settings
chat_data/
browser_chat_profile/
browser_profile/
puter_chat/

# 6. Ignore downloaded binaries and runtimes
python/
bin/
*.zip
*.tar
*.tar.gz
*.exe
*.msi
*.mp3
*.mp4
*.png
*.pdf
*.txt

logs/
installer_data/

# 7. Ignore Windows system files
Thumbs.db
Desktop.ini
.DS_Store
LocalLow/
Microsoft/
System Volume Information/
node_modules/
.venv/
venv/
.expo/
dist/
backup/
temp/
